# FixRx Environment Configuration

# WebSocket Server Configuration
EXPO_PUBLIC_WS_URL=ws://localhost:3001

# API Configuration
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_API_PORT=3000
EXPO_PUBLIC_API_PATH=/api/v1

# Local Development
EXPO_PUBLIC_LOCAL_IP=127.0.0.1

# Demo Mode
EXPO_PUBLIC_DEMO_MODE=false

# Mock Messaging (set to true to use mock data instead of WebSocket)
EXPO_PUBLIC_USE_MOCK_MESSAGING=false

# Google OAuth (add your client IDs here)
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Stripe (add your publishable key here)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=